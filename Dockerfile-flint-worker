# syntax=docker/dockerfile:1
#
# flint-worker: a single, consolidated image that bundles the FLINT pipeline
# (askap-flint) together with the radio-astronomy tools it shells out to, plus a
# Dask + JupyterLab runtime.
#
# It is designed to be used in TWO roles with an IDENTICAL environment (a hard
# requirement for Dask: scheduler, workers and the client/notebook must share the
# same Python and library versions):
#
#   1. JupyterHub singleuser image (Zero-to-JupyterHub `singleuser.image`).
#   2. Dask worker/scheduler image for the dask-kubernetes operator
#      (`KubeCluster(image=...)`).
#
# Both Z2JH and the dask-kubernetes operator override the container command, so we
# only provide a sensible default CMD for standalone use.
#
# Tools included:
#   - wsclean, aoflagger, casacore tools  (from the KERN-9 apt repo)
#   - calibrate (Offringa/Lenc) built from the ./calibrate submodule
#   - aegean (source finding) and potato (peeling) via pip
#   - askap-flint, dask[distributed], dask-kubernetes, prefect-dask
#   - jupyterlab / jupyterhub / notebook + dask-labextension

############################
# Stage 1: build calibrate #
############################
FROM kernsuite/base:9 AS calibrate-build

RUN docker-apt-install \
    build-essential \
    cmake \
    git \
    libcfitsio-dev \
    libgsl-dev \
    casacore-dev \
    libboost-dev \
    libboost-filesystem-dev \
    libboost-date-time-dev \
    libboost-system-dev \
    libboost-thread-dev

# The calibrate sources are vendored as a git submodule of this repo.
COPY ./calibrate /calibrate
WORKDIR /calibrate
RUN mkdir -p build && cd build && \
    cmake ../ && \
    make -j"$(nproc)" && \
    make install DESTDIR=/opt/calibrate-install

#####################
# Stage 2: runtime  #
#####################
FROM kernsuite/base:9

LABEL org.opencontainers.image.title="flint-worker" \
      org.opencontainers.image.description="Consolidated FLINT pipeline + radio tools + Dask/Jupyter runtime for JupyterHub and dask-kubernetes." \
      org.opencontainers.image.source="https://github.com/whatnick/flint-containers"

ENV DEBIAN_FRONTEND=noninteractive \
    NB_USER=jovyan \
    NB_UID=1000 \
    NB_GID=1000 \
    HOME=/home/jovyan \
    PATH="/opt/venv/bin:${PATH}" \
    VIRTUAL_ENV=/opt/venv

# Runtime radio tools from the KERN-9 repo + a Python toolchain.
RUN docker-apt-install \
        wsclean \
        aoflagger \
        casacore-dev \
        casacore-tools \
        python3 \
        python3-venv \
        python-is-python3 \
        git \
        curl \
        rsync \
        ca-certificates \
        tini && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Bring in the calibrate binaries/libraries built in stage 1.
COPY --from=calibrate-build /opt/calibrate-install/ /

# Install uv (fast resolver) and use it to populate a self-contained virtualenv so
# the Python environment is reproducible and easy to mount/inspect.
ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh
ENV PATH="/root/.local/bin:${PATH}"

RUN uv venv --system-site-packages "${VIRTUAL_ENV}" && \
    uv pip install --python "${VIRTUAL_ENV}/bin/python" --no-cache \
        "askap-flint" \
        "dask[distributed]" \
        "dask-kubernetes" \
        "prefect-dask" \
        "bokeh" \
        "jupyterlab" \
        "jupyterhub" \
        "notebook" \
        "dask-labextension" \
        "git+https://github.com/PaulHancock/Aegean.git" \
        "git+https://gitlab.com/Sunmish/potato.git"

# Non-root user expected by Zero-to-JupyterHub and friendlier for dask workers.
RUN groupadd -g "${NB_GID}" "${NB_USER}" && \
    useradd -m -s /bin/bash -u "${NB_UID}" -g "${NB_GID}" "${NB_USER}" && \
    mkdir -p "${HOME}/work" && \
    chown -R "${NB_UID}:${NB_GID}" "${HOME}" "${VIRTUAL_ENV}"

USER ${NB_UID}
WORKDIR ${HOME}

# Quick sanity check that the key entrypoints resolve at build time.
RUN python -c "import flint, dask, dask_kubernetes, distributed" && \
    which wsclean aoflagger calibrate dask jupyterhub-singleuser

# tini reaps zombies for the long-running notebook/worker processes.
ENTRYPOINT ["tini", "-g", "--"]
# Default for standalone use; Z2JH and the dask operator override this.
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--no-browser"]
