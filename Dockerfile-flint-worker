# syntax=docker/dockerfile:1
#
# flint-worker: a single, consolidated image bundling the FLINT pipeline
# (askap-flint) with the radio-astronomy tools it shells out to, on top of a
# Jupyter Docker Stacks base (https://github.com/jupyter/docker-stacks).
#
# It is meant to be used in TWO roles with an IDENTICAL environment (a hard Dask
# requirement: scheduler, workers and the client/notebook must match):
#
#   1. JupyterHub singleuser image (Zero-to-JupyterHub `singleuser.image`).
#   2. Dask worker/scheduler image for the dask-kubernetes operator
#      (`KubeCluster(image=...)`).
#
# Basing on docker-stacks gives us the `jovyan` user (uid 1000), conda/mamba, a
# pre-wired JupyterLab/JupyterHub-singleuser stack, the `start-notebook` scripts
# expected by Z2JH, and `tini` as the entrypoint. We therefore deliberately do
# NOT override ENTRYPOINT/CMD -- Z2JH and the dask operator each supply their own.
#
# Tool sourcing rationale:
#   - wsclean, aoflagger: not on conda-forge, installed from the KERN apt repo.
#     docker-stacks is Ubuntu 24.04 (noble), which matches KERN-10.
#   - calibrate (Offringa/Lenc): built from the ./calibrate submodule against the
#     same KERN-10 system libraries (multi-stage), then copied in.
#   - python-casacore / dask / flint / aegean / potato: installed into the conda
#     environment so they share the notebook's Python.

############################################
# Stage 1: build calibrate against KERN-10 #
############################################
FROM kernsuite/base:10 AS calibrate-build

RUN docker-apt-install \
    build-essential \
    cmake \
    git \
    libcfitsio-dev \
    libgsl-dev \
    casacore-dev \
    libboost-dev \
    libboost-filesystem-dev \
    libboost-date-time-dev \
    libboost-system-dev \
    libboost-thread-dev

# calibrate sources are vendored as a git submodule of this repo.
COPY ./calibrate /calibrate
WORKDIR /calibrate
RUN mkdir -p build && cd build && \
    cmake ../ && \
    make -j"$(nproc)" && \
    make install DESTDIR=/opt/calibrate-install

####################################################
# Stage 2: runtime on the Jupyter Docker Stacks base #
####################################################
# Pinned date tag for reproducibility (Ubuntu 24.04 / noble, Python 3.13).
FROM quay.io/jupyter/scipy-notebook:2026-05-11

LABEL org.opencontainers.image.title="flint-worker" \
      org.opencontainers.image.description="askap-flint + radio tools (wsclean/aoflagger/calibrate) + Dask on a Jupyter Docker Stacks base, for JupyterHub and dask-kubernetes." \
      org.opencontainers.image.source="https://github.com/whatnick/flint-containers"

# --- system radio tools from KERN-10 (needs root) ---------------------------
USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends software-properties-common && \
    add-apt-repository -y ppa:kernsuite/kern-10 && \
    apt-add-repository -y multiverse && \
    apt-add-repository -y restricted && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        wsclean \
        aoflagger \
        casacore-dev \
        casacore-tools \
        libcfitsio-dev \
        libgsl-dev \
        libboost-filesystem-dev \
        libboost-date-time-dev \
        libboost-system-dev \
        libboost-thread-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Bring in the calibrate binaries built in stage 1 (links against KERN-10 libs
# installed above).
COPY --from=calibrate-build /opt/calibrate-install/ /

# --- Python environment (as the unprivileged notebook user) ------------------
USER ${NB_UID}

# Radio + Dask Python stack from conda-forge (shares the notebook's Python).
RUN mamba install --yes -c conda-forge \
        "python-casacore" \
        "dask" \
        "distributed" \
        "dask-kubernetes" \
        "bokeh" \
        "dask-labextension" && \
    mamba clean --all --force-pkgs-dirs --yes && \
    fix-permissions "${CONDA_DIR}" && \
    fix-permissions "/home/${NB_USER}"

# FLINT itself plus the pip-only source-finding / peeling tools.
RUN pip install --no-cache-dir \
        "askap-flint" \
        "prefect-dask" \
        "git+https://github.com/PaulHancock/Aegean.git" \
        "git+https://gitlab.com/Sunmish/potato.git" && \
    fix-permissions "${CONDA_DIR}" && \
    fix-permissions "/home/${NB_USER}"

# Sanity check that the key entrypoints resolve at build time.
RUN python -c "import flint, dask, dask_kubernetes, distributed, casacore" && \
    which wsclean aoflagger calibrate

# Inherit docker-stacks ENTRYPOINT (tini) + CMD (start-notebook). Z2JH and the
# dask-kubernetes operator override the command as needed.
